# API Configuration
# IMPORTANT: Copy this file to .env and update with your actual values
# The .env file is gitignored and should not be committed to version control

# Backend API Base URL
# For physical device: Use your computer's IP address (e.g., http://192.168.1.100:8000)
# For Android emulator: Use http://10.0.2.2:8000
# For iOS simulator: Use http://localhost:8000
API_BASE_URL=http://localhost:8000

# API Version
API_VERSION=v1

# API Key for authentication (development key - change in production)
API_KEY=dev-api-key-12345

# Timeouts (in seconds)
CONNECT_TIMEOUT=10
RECEIVE_TIMEOUT=30

# AI Engine Configuration
AI_ENGINE_URL=http://localhost:8001
AI_ENGINE_PORT=8001

# Sync Configuration
SYNC_BATCH_SIZE=100
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY_SECONDS=5

# MinIO Configuration (for file storage)
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_PHOTOS=tutas-photos
MINIO_BUCKET_REPORTS=tutas-reports

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Domain Configuration
DOMAIN=localhost
BACKEND_PORT=8000

# SSL Certificate Pinning (for production)
# Add your server's certificate SHA-256 fingerprint here
# SSL_PIN_SHA256=your_certificate_sha256_hash_here

# Debug Mode
DEBUG=false
